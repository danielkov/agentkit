          "name": "compose",
          "input": {
            "script": "services = list_services({})\n# For each service, get ERROR logs count and first page to understand timing\nerror_summaries = for svc in services {\n    logs = search_logs({ service: svc, level: \"ERROR\", page: 1 })\n    return { service: svc, total_errors: logs.total_items, total_pages: logs.total_pages }\n}\nreturn error_summaries"
          },
          "metadata": {}
        }
      }
