          "name": "compose",
          "input": {
            "script": "local services = tool('list_services', {})\nlocal results = {}\n\nfor _, svc in ipairs(services) do\n  -- Get ERROR logs count / timing for the service\n  local page = 1\n  local all_errors = {}\n  local total_pages = 1\n  repeat\n    local r = tool('search_logs', { service = svc, level = 'ERROR', page = page })\n    total_pages = r.total_pages\n    for _, item in ipairs(r.items) do\n      all_errors[#all_errors + 1] = item\n    end\n    page = page + 1\n  until page > total_pages or page > 50\n\n  -- bucket by hour\n  local buckets = {}\n  for _, e in ipairs(all_errors) do\n    local hour = e.ts and string.sub(e.ts, 1, 13) or 'unknown'\n    buckets[hour] = (buckets[hour] or 0) + 1\n  end\n\n  local deploys = tool('get_deploys', { service = svc })\n  local owner = tool('get_service_owners', { service = svc })\n\n  results[svc] = {\n    total_errors = #all_errors,\n    total_items_reported = (tool('search_logs', { service = svc, level = 'ERROR', page = 1 })).total_items,\n    buckets = buckets,\n    deploys = deploys,\n    owner = owner\n  }\nend\n\nreturn results\n"
          },
          "metadata": {}
        }
      }
    ],
