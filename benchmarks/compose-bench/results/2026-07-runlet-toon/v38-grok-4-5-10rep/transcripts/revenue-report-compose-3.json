        "Text": {
          "text": "Compute total revenue for March 2026 (month \"2026-03\") per customer billing region, counting ONLY orders with status \"completed\" (exclude refunded and pending). Report each region's total in integer cents. When done, submit {\"NA\": <cents>, \"EU\": <cents>, \"APAC\": <cents>} via submit_result.",
          "metadata": {}
        }
      }
    ],
    "metadata": {},
