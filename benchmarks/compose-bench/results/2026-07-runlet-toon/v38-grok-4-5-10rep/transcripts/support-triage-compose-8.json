        "ToolCall": {
          "id": "call-d99c15ff-7bcf-43ae-9b10-fa4ddfbf980e-0",
          "name": "compose",
          "input": {
            "script": "local page = 1\nlocal open_tickets = {}\nrepeat\n  local r = tool('list_tickets', { page = page, status = 'open' })\n  for _, it in ipairs(r.items) do\n    open_tickets[#open_tickets + 1] = it\n  end\n  page = page + 1\nuntil page > r.total_pages\n\nlocal cutoff = '2026-06-03'\nlocal escalated = {}\nfor _, it in ipairs(open_tickets) do\n  local created = it.created_at or ''\n  local date = created:sub(1, 10)\n  if date ~= '' and date < cutoff then\n    local full = tool('get_ticket', { id = it.id })\n    local body = full.body or ''\n    if body:lower():find('refund') then\n      tool('update_ticket', { id = it.id, priority = 'high', add_tags = { 'billing-escalation' } })\n      escalated[#escalated + 1] = it.id\n    end\n  end\nend\nreturn escalated"
          },
          "metadata": {}
        }
      }
    ],
