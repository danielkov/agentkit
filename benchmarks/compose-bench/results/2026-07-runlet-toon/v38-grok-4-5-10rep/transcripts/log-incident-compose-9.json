        "ToolCall": {
          "id": "call-395b7260-d379-480c-af69-c85a9512d2fd-0",
          "name": "compose",
          "input": {
            "script": "local services = tool('list_services', {})\nlocal results = {}\n\nfor _, svc in ipairs(services) do\n  -- Get error counts - paginate to count total errors\n  local r = tool('search_logs', { service = svc, level = 'ERROR', page = 1 })\n  results[#results + 1] = { service = svc, total_errors = r.total_items }\nend\n\nreturn { services = services, error_counts = results }"
          },
          "metadata": {}
        }
      }
