        "ToolCall": {
          "id": "call-aa2e77a7-60a6-4872-a509-09676ff4c1a4-2",
          "name": "compose",
          "input": {
            "script": "local logs = {}\nlocal page = 1\nlocal total_pages = 1\nrepeat\n  local r = tool('search_logs', { service = 'payments', level = 'ERROR', page = page })\n  total_pages = r.total_pages\n  for _, item in ipairs(r.items) do\n    logs[#logs + 1] = { ts = item.ts, message = item.message }\n  end\n  page = page + 1\nuntil page > total_pages\n\nlocal deploys = tool('get_deploys', { service = 'payments' })\nlocal owner = tool('get_service_owners', { service = 'payments' })\n\nreturn { errors = logs, deploys = deploys, owner = owner }"
          },
          "metadata": {}
        }
      }
