          "name": "compose",
          "input": {
            "script": "services = list_services({})\n# For each service, get error log pages and deploys in parallel\nresults = for svc in services {\n    deploys = get_deploys({ service: svc })\n    # Get first page of ERROR logs to see volume and timing\n    logs1 = search_logs({ service: svc, level: \"ERROR\", page: 1 })\n    return {\n        service: svc,\n        deploys: deploys,\n        error_total: logs1.total_items,\n        error_pages: logs1.total_pages,\n        first_page: logs1.items\n    }\n}\nreturn results"
          },
          "metadata": {}
        }
      }
