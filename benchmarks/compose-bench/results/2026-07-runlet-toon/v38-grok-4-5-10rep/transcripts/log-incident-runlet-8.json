            "script": "services = list_services({})\n\n# For each service, get error log pages and deploys + owner in parallel\nresults = for svc in services {\n    # First page of errors to get total counts\n    errors_p1 = boundary retry 2 {\n        return search_logs({ service: svc, level: \"ERROR\", page: 1 })\n    } catch err {\n        return fail(\"LOGS\", err.message)\n    }\n\n    # Sample more pages to see time distribution - get page totals and look at timestamps\n    # Also fetch a middle and last page if multi-page\n    last_page_num = errors_p1.total_pages if errors_p1.total_pages > 0 else 1\n    mid_page_num = number.floor((last_page_num + 1) / 2)\n\n    errors_last = boundary retry 2 {\n        return search_logs({ service: svc, level: \"ERROR\", page: last_page_num })\n    } catch err {\n        return fail(\"LOGS\", err.message)\n    } if last_page_num > 1 else errors_p1\n\n    errors_mid = boundary retry 2 {\n        return search_logs({ service: svc, level: \"ERROR\", page: mid_page_num })\n    } catch err {\n        return fail(\"LOGS\", err.message)\n    } if mid_page_num != 1 and mid_page_num != last_page_num else null\n\n    deploys = boundary retry 2 {\n        return get_deploys({ service: svc })\n    } catch err {\n        return fail(\"DEPLOYS\", err.message)\n    }\n\n    owner = boundary retry 2 {\n        return get_service_owners({ service: svc })\n    } catch err {\n        return fail(\"OWNER\", err.message)\n    }\n\n    first_ts = errors_p1.items[0].ts if errors_p1.items != [] else null\n    last_ts = errors_last.items[list.length(errors_last.items) - 1].ts if errors_last.items != [] else null\n    mid_items = errors_mid.items if errors_mid != null else []\n\n    return {\n        service: svc,\n        total_errors: errors_p1.total_items,\n        total_pages: errors_p1.total_pages,\n        first_page_ts: for e in errors_p1.items { return e.ts },\n        mid_page_ts: for e in mid_items { return e.ts },\n        last_page_ts: for e in errors_last.items { return e.ts },\n        first_ts: first_ts,\n        last_ts: last_ts,\n        deploys: deploys,\n        owner_email: owner.owner_email\n    }\n}\n\nreturn results"
          },
