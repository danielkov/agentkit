poration\",  email=\"contact16@acme.com\",    phone=\"+14155550116\"},\n  {id=\"CT-017\", company=\"Globex\",            email=\"contact17@globex.io\",   phone=\"(415) 555-0117\"},\n  {id=\"CT-018\", company=\"Initech\",           email=\"contact18@initech.dev\", phone=\"415.555.0118\"},\n  {id=\"CT-019\", company=\"Umbrella Holdings\", email=\"contact19@umbrella.co\", phone=\"+1-415-555-0119\"},\n  {id=\"CT-020\", company=\"\",                  email=\"contact20@acme.com\",    phone=\"+14155550120\"},\n  {id=\"CT-021\", company=\"Globex\",            email=\"contact21@globex.io\",   phone=\"(415) 555-0121\"},\n  {id=\"CT-022\", company=\"Initech\",           email=\"contact22@initech.dev\", phone=\"415.555.0122\"},\n  {id=\"CT-023\", company=\"Umbrella Holdings\", email=\"contact23@umbrella.co\", phone=\"+1-415-555-0123\"},\n  {id=\"CT-024\", company=\"Acme Corporation\",  email=\"contact24@acme.com\",    phone=\"+14155550124\"},\n}\n\n-- E.164 US check: +1 followed by exactly 10 digits\nlocal function is_e164(p)\n  return p:match(\"^%+1%d%d%d%d%d%d%d%d%d%d$\") ~= nil\nend\n\n-- Convert to E.164 by stripping non-digits\nlocal function to_e164(p)\n  local digits = p:gsub(\"%D\", \"\")\n  -- remove leading country code 1 if 11 digits\n  if #digits == 11 and digits:sub(1,1) == \"1\" then\n    digits = digits:sub(2)\n  end\n  return \"+1\" .. digits\nend\n\nlocal phones_fixed = 0\nlocal companies_filled = 0\nlocal updates = {}\n\nfor _, c in ipairs(contacts) do\n  local payload = { id = c.id }\n  local need = false\n\n  -- Phone fix\n  if not is_e164(c.phone) then\n    payload.phone = to_e164(c.phone)\n    phones_fixed = phones_fixed + 1\n    need = true\n  end\n\n  -- Company fill\n  if c.company == \"\" then\n    local domain = c.email:match(\"@(.+)$\")\n    local name = domain and companies[domain]\n    if name then\n      payload.company = name\n      companies_filled = companies_filled + 1\n      need = true\n    end\n  end\n\n  if need then updates[#updates+1] = payload end\nend\n\n-- Apply all updates\nlocal results = {}\nfor _, u in ipairs(updates) do\n  results[#results+1] = tool('update_contact', u)\nend\n\nreturn { phones_fixed = phones_fixed, companies_filled = companies_filled, updates_applied = #updates }\n"
