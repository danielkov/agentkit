          "input": {
            "script": "services = list_services({})\n# Get error log counts per service - sample first page and get totals\nerror_totals = for svc in services {\n    logs = boundary retry 2 {\n        return search_logs({ service: svc, level: \"ERROR\", page: 1 })\n    } catch err {\n        return fail(\"LOGS\", err.message)\n    }\n    return { service: svc, total_errors: logs.total_items, total_pages: logs.total_pages }\n}\ndeploys = for svc in services {\n    d = boundary retry 2 {\n        return get_deploys({ service: svc })\n    } catch err {\n        return fail(\"DEPLOYS\", err.message)\n    }\n    return { service: svc, deploys: d }\n}\nreturn { services, error_totals, deploys }"
          },
