          "name": "compose",
          "input": {
            "script": "local services = tool('list_services', {})\nlocal result = { services = services, error_counts = {}, deploys = {}, owners = {} }\n\nfor _, svc in ipairs(services) do\n  -- Get all ERROR logs for the service (paginate)\n  local page = 1\n  local total_errors = 0\n  local by_hour = {}\n  local all_ts = {}\n  local total_pages = 1\n  repeat\n    local r = tool('search_logs', { service = svc, level = 'ERROR', page = page })\n    total_pages = r.total_pages\n    total_errors = r.total_items\n    for _, item in ipairs(r.items) do\n      local hour = string.sub(item.ts or '', 1, 13)  -- YYYY-MM-DDTHH\n      by_hour[hour] = (by_hour[hour] or 0) + 1\n      all_ts[#all_ts + 1] = item.ts\n    end\n    page = page + 1\n  until page > total_pages or page > 50\n  \n  result.error_counts[svc] = { total = total_errors, by_hour = by_hour }\n  \n  -- Get deploys\n  local deploys = tool('get_deploys', { service = svc })\n  result.deploys[svc] = deploys\n  \n  -- Get owner\n  local owner = tool('get_service_owners', { service = svc })\n  result.owners[svc] = owner\nend\n\nreturn result"
          },
          "metadata": {}
        }
      }
    ],
