            "script": "local services = tool('list_services', {})\nlocal results = {}\n\nfor _, svc in ipairs(services) do\n  -- Get error logs - paginate to count errors and find timing\n  local page = 1\n  local total_errors = 0\n  local error_times = {}\n  local total_pages = 1\n  repeat\n    local r = tool('search_logs', { service = svc, level = 'ERROR', page = page })\n    total_pages = r.total_pages\n    total_errors = r.total_items\n    for _, item in ipairs(r.items) do\n      error_times[#error_times + 1] = item.ts\n    end\n    page = page + 1\n  until page > total_pages or page > 50  -- safety limit\n  \n  local deploys = tool('get_deploys', { service = svc })\n  local owner = tool('get_service_owners', { service = svc })\n  \n  results[svc] = {\n    total_errors = total_errors,\n    error_times_sample = error_times,\n    deploys = deploys,\n    owner = owner\n  }\nend\n\nreturn results"
          },
          "metadata": {}
        }
      }
