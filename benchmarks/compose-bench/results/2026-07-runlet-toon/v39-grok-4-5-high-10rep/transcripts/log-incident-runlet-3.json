            "script": "services = [\"auth\", \"checkout\", \"payments\", \"search\"]\nlog_summaries = for svc in services {\n  first = boundary retry 2 {\n    return search_logs({ service: svc, level: \"ERROR\", page: 1 })\n  } catch err {\n    return fail(\"LOGS\", err.code + \": \" + err.message)\n  }\n  deploys = boundary retry 2 {\n    return get_deploys({ service: svc })\n  } catch err {\n    return fail(\"DEPLOYS\", err.code + \": \" + err.message)\n  }\n  # sample a few pages across the day to find spikes\n  pages_to_check = if first.total_pages > 1 {\n    return list.range(2, first.total_pages + 1)\n  } else {\n    return []\n  }\n  # limit pages checked - get timestamps from page 1 and middle/last\n  mid = if first.total_pages > 2 {\n    return number.floor(first.total_pages / 2)\n  } else {\n    return 1\n  }\n  last_page_num = first.total_pages\n  mid_page = boundary retry 2 {\n    return search_logs({ service: svc, level: \"ERROR\", page: mid })\n  } catch err {\n    return fail(\"LOGS\", err.code + \": \" + err.message)\n  } if mid > 1 else { items: [], page: mid, total_items: first.total_items, total_pages: first.total_pages }\n  last_page = boundary retry 2 {\n    return search_logs({ service: svc, level: \"ERROR\", page: last_page_num })\n  } catch err {\n    return fail(\"LOGS\", err.code + \": \" + err.message)\n  } if last_page_num > 1 else first\n  return {\n    service: svc,\n    total_errors: first.total_items,\n    total_pages: first.total_pages,\n    first_ts: first.items[0].ts if first.items != [] else null,\n    mid_ts: mid_page.items[0].ts if mid_page.items != [] else null,\n    last_ts: last_page.items[list.length(last_page.items) - 1].ts if last_page.items != [] else null,\n    first_items: first.items,\n    deploys: deploys\n  }\n}\nreturn log_summaries"
          },
