            },
            "script": "\nlocal domain_to_company = {\n  [\"acme.com\"] = \"Acme Corporation\",\n  [\"globex.io\"] = \"Globex\",\n  [\"initech.dev\"] = \"Initech\",\n  [\"umbrella.co\"] = \"Umbrella Holdings\",\n}\n\nlocal phones_fixed = 0\nlocal companies_filled = 0\nlocal changes = {}\n\n-- E.164 check: +1 followed by exactly 10 digits\nlocal function is_e164(p)\n  return p:match(\"^%+1%d%d%d%d%d%d%d%d%d%d$\") ~= nil\nend\n\nlocal function to_e164(p)\n  local digits = p:gsub(\"%D\", \"\")\n  -- Strip a leading country code 1 if present, keep last 10\n  if #digits == 11 and digits:sub(1,1) == \"1\" then\n    digits = digits:sub(2)\n  end\n  return \"+1\" .. digits\nend\n\nfor _, c in ipairs(input.contacts) do\n  local upd = {}\n  local need = false\n\n  -- Phone fix\n  if not is_e164(c.phone) then\n    upd.phone = to_e164(c.phone)\n    need = true\n  end\n\n  -- Company fill\n  if (c.company == nil or c.company == \"\") then\n    local domain = c.email:match(\"@(.+)$\")\n    local comp = domain and domain_to_company[domain]\n    if comp then\n      upd.company = comp\n      need = true\n    end\n  end\n\n  if need then\n    upd.id = c.id\n    local res = tool(\"update_contact\", upd)\n    if upd.phone then phones_fixed = phones_fixed + 1 end\n    if upd.company then companies_filled = companies_filled + 1 end\n    changes[#changes+1] = { id = c.id, phone = upd.phone, company = upd.company }\n  end\nend\n\nreturn { phones_fixed = phones_fixed, companies_filled = companies_filled, changes = changes }\n"
