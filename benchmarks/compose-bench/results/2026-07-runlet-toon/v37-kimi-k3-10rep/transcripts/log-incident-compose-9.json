          "input": {
            "script": "local services = tool('list_services', {})\nlocal summary = {}\nfor _, svc in ipairs(services) do\n  local page, total = 1, 0\n  local hourly = {}\n  local firstErr, lastErr\n  repeat\n    local r = tool('search_logs', { service = svc, level = 'ERROR', page = page })\n    for _, e in ipairs(r.items) do\n      total = total + 1\n      local h = string.sub(e.ts or '', 1, 13)\n      hourly[h] = (hourly[h] or 0) + 1\n      if not firstErr then firstErr = e.ts end\n      lastErr = e.ts\n    end\n    page = page + 1\n  until page > (r.total_pages or 1)\n  summary[svc] = { total = total, hourly = hourly, first = firstErr, last = lastErr }\nend\nreturn summary"
          },
          "metadata": {}
        }
      }
