          "input": {
            "script": "local services = tool('list_services', {})\nlocal result = {}\nfor _, svc in ipairs(services) do\n  local page = 1\n  local hours = {}\n  local total = 0\n  repeat\n    local r = tool('search_logs', { service = svc, level = 'ERROR', page = page })\n    for _, it in ipairs(r.items) do\n      local h = string.sub(it.ts or '', 1, 13) -- hour bucket\n      hours[h] = (hours[h] or 0) + 1\n      total = total + 1\n    end\n    page = page + 1\n  until page > r.total_pages\n  result[svc] = { total_errors = total, by_hour = hours }\nend\nreturn result"
          },
          "metadata": {}
        }
      }
