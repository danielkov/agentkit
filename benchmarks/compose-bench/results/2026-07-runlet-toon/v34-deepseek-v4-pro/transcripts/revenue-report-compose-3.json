            "script": "-- 1. List all 4 pages\nlocal allOrders = {}\nfor page = 1, 4 do\n  local res = tool(\"list_orders\", { month = \"2026-03\", page = page })\n  for _, ord in ipairs(res.items) do\n    allOrders[#allOrders + 1] = ord\n  end\nend\n\n-- 2. Track totals per region\nlocal totals = { NA = 0, EU = 0, APAC = 0 }\n\nfor _, ord in ipairs(allOrders) do\n  local order = tool(\"get_order\", { id = ord.id })\n  if order.status == \"completed\" then\n    local cust = tool(\"get_customer\", { id = ord.customer_id })\n    local region = cust.region\n    totals[region] = totals[region] + order.amount_cents\n  end\nend\n\nreturn totals"
          },
